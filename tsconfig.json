{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "client",
    "harness",
    "app/src",
    "vite.app.config.ts",
    "server",
    "mcp",
    "tools",
    "stories",
    ".storybook",
    "node_modules/@openflow/protocol/global.d.ts",
    "types/assets.d.ts",
    "types/milkdrop.d.ts"
  ]
}
