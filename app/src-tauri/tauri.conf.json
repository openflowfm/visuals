{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "visual[flow]",
  "version": "0.2.0",
  "identifier": "fm.openflow.visuals",
  "build": {
    "frontendDist": "../../dist-app",
    "beforeDevCommand": "npm --prefix .. run app:ui",
    "beforeBuildCommand": "npm --prefix .. run app:build-ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "visual[flow]",
        "width": 1600,
        "height": 1000,
        "minWidth": 560,
        "minHeight": 640,
        "transparent": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active"
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "presets/starter/": "presets/starter/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_CONTENTS_OF_visual-flow-updater.key.pub",
      "endpoints": ["https://github.com/openflowfm/visuals/releases/latest/download/latest.json"]
    }
  }
}
