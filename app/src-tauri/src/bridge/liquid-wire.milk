[preset00]
fRating=5
fGammaAdj=1.4
fDecay=0.91
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
fWaveAlpha=0
bTexWrap=1
bDarkenCenter=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
warp=0
sx=1
sy=1
ob_a=0
ib_a=0
mv_a=0
per_frame_1=zoom=1.009+0.012*min(bass,2); rot=0.01*min(mid,2);
per_pixel_1=dx=0.019*sin(y*17+time*1.9)+0.008*cos(x*11-time); dy=0.014*cos(x*14-time*1.5); rot=0.012*sin(x*9+y*7+time);
comp_1=`shader_body
comp_2=`{
comp_3=`float2 d = float2((0.012+0.005*min(treb,2))*sin(uv.y*24+time*1.5),0.008*cos(uv.x*19-time));
comp_4=`float3 a = tex2D(sampler_main,uv+d).xyz;
comp_5=`float3 b = tex2D(sampler_main,uv-d).xyz;
comp_6=`ret = float3(a.r,b.g,a.b)*1.5 + b.zxy*0.3;
comp_7=`ret = min(float3(1,1,1), pow(max(ret,float3(0,0,0)),float3(0.65,0.65,0.65))*1.35);
comp_8=`}
