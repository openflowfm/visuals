{
  "name": "@openflow/visuals",
  "version": "0.2.0",
  "private": true,
  "author": "Ryan Gavin",
  "type": "module",
  "description": "visual[flow]: a MilkDrop engine and editor app that follows Ableton Link.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openflowfm/visuals.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:stories": "vitest run --project stories",
    "storybook": "storybook dev -p \"${PORT:-6006}\"",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "format:check": "prettier --check app/src",
    "app:ui": "vite --config vite.app.config.ts",
    "app:build-ui": "vite build --config vite.app.config.ts",
    "app:build-ui:lab": "VITE_LAB=1 vite build --config vite.app.config.ts",
    "app": "app/run.sh",
    "app:lab": "VITE_LAB=1 app/run.sh --features lab",
    "dev": "app/dev.sh",
    "dev:lab": "VITE_LAB=1 app/dev.sh --features lab",
    "dev:app": "VISUALS_DEV_APP=1 app/run.sh",
    "dev:app:lab": "VITE_LAB=1 VISUALS_DEV_APP=1 app/run.sh --features lab",
    "check:no-dev-code": "node app/no-dev-code.mjs",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@satoramoto/zen": "github:satoramoto/zen#c365bc46cc16223555c04925d0f56b6108f9dd40",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@storybook/addon-vitest": {
      "@vitest/browser": "^5.0.1",
      "@vitest/browser-playwright": "^5.0.1",
      "@vitest/runner": "^5.0.1",
      "vitest": "^5.0.1"
    }
  },
  "allowScripts": {
    "@satoramoto/zen@0.1.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -x node_modules/.bin/lint-staged ]; then node_modules/.bin/lint-staged; else echo 'pre-commit: lint-staged is not installed in this checkout (npm install); skipping'; fi"
  },
  "lint-staged": {
    "app/src/**/*": "prettier --write --ignore-unknown",
    "*.rs": "rustfmt --edition 2024"
  }
}
