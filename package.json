{
  "name": "@openflow/visuals",
  "version": "0.1.0-rc.4",
  "private": true,
  "author": "Ryan Gavin",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "description": "visual[flow]: an Ableton Link peer that renders a Live set from a node graph.",
  "scripts": {
    "build:link": "node --disable-warning=ExperimentalWarning tools/build-link.ts",
    "nodes": "node --disable-warning=ExperimentalWarning tools/generate-nodes.ts",
    "nodes:check": "node --disable-warning=ExperimentalWarning tools/generate-nodes.ts --check",
    "mcp": "npm run nodes && node --disable-warning=ExperimentalWarning mcp/index.ts",
    "model:xenon": "node --disable-warning=ExperimentalWarning tools/generate-xenon-60-model.ts",
    "model:proof": "node --disable-warning=ExperimentalWarning tools/xenon-model-proof.ts",
    "model:showcase": "node --disable-warning=ExperimentalWarning tools/model-showcase.ts",
    "benchmark": "node --disable-warning=ExperimentalWarning tools/benchmark.ts",
    "frames": "node --disable-warning=ExperimentalWarning tools/frames.ts",
    "footage:frames": "node --disable-warning=ExperimentalWarning tools/footage-frames.ts",
    "structure:compare": "node --disable-warning=ExperimentalWarning tools/structure-compare.ts",
    "show": "node --disable-warning=ExperimentalWarning tools/visuals.ts"
  },
  "dependencies": {
    "@ktamas77/abletonlink": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/three": "^0.180.0"
  }
}
