{
  "name": "@openflow/visuals",
  "version": "0.2.0",
  "private": true,
  "author": "Ryan Gavin",
  "type": "module",
  "description": "visual[flow]: a MilkDrop engine and editor app that follows Ableton Link.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openflowfm/visuals.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check app/src",
    "app:ui": "vite --config vite.app.config.ts",
    "app:build-ui": "vite build --config vite.app.config.ts",
    "app:build-ui:lab": "VITE_LAB=1 vite build --config vite.app.config.ts",
    "app": "app/run.sh",
    "app:lab": "VITE_LAB=1 app/run.sh --features lab"
  },
  "dependencies": {
    "@openflow/widgets": "git+https://github.com/openflowfm/widgets.git#147983bb76764b2ae8036c7b0f5d5367eed86b83",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
