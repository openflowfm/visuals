{
  "name": "@openflow/visuals",
  "version": "0.2.0",
  "private": true,
  "author": "Ryan Gavin",
  "type": "module",
  "description": "visual[flow]: a MilkDrop engine and editor app that follows Ableton Link.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openflowfm/visuals.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "app:ui": "vite --config vite.app.config.ts",
    "app:build-ui": "vite build --config vite.app.config.ts",
    "app": "cd app/src-tauri && export PORT=${PORT:-$(node -e \"const s=require('net').createServer().listen(0,'127.0.0.1',()=>{console.log(s.address().port);s.close()})\")} && cargo tauri dev --config \"{\\\"build\\\":{\\\"devUrl\\\":\\\"http://127.0.0.1:$PORT\\\"}}\""
  },
  "dependencies": {
    "@openflow/widgets": "git+https://github.com/openflowfm/widgets.git#dc356455e561c7eb9dce337a1e6b6810a5251fcb",
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
